# ---------------------------------------------------------------------------
# VetMoment — запуск без Docker (Laravel Herd for Windows или локальный PHP 8.4).
# База — файл database/database.sqlite, PostgreSQL не нужен.
#
#   copy .env.sqlite.example .env
#   composer install
#   php artisan key:generate
#   type nul > database\database.sqlite
#   php artisan migrate --seed
#   php artisan storage:link
#   npm install && npm run build
#   php artisan serve
# ---------------------------------------------------------------------------

APP_NAME=VetMoment
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_DISPLAY_TIMEZONE=Asia/Almaty

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Путь не указываем — Laravel возьмёт database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Без отдельного воркера очереди задачи выполняются сразу
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@vetmoment.kz"
MAIL_FROM_NAME="${APP_NAME}"

# Платежи: fake — демо-страница банка (настоящие деньги не списываются).
PAYMENT_GATEWAY=fake
PAYMENT_PENDING_TTL=60

VITE_APP_NAME="${APP_NAME}"
