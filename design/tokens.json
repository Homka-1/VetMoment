{
  "$description": "Дизайн-токены VetMoment (этап 2). Источник истины для @theme Tailwind 4 (этап 7), UI-кита и макетов. Формат близок к W3C Design Tokens: $value + $type. Описание — docs/design/tokens.md.",
  "color": {
    "ink": {
      "$type": "color",
      "$description": "«Ночная степь» — основной тёмно-синий: текст, основные кнопки, тёмные поверхности.",
      "950": { "$value": "#131C36" },
      "900": { "$value": "#1D2B4F" },
      "800": { "$value": "#2A3A63" },
      "700": { "$value": "#3D4A6E" },
      "600": { "$value": "#4F5B7D" },
      "500": { "$value": "#5B6584" },
      "400": { "$value": "#8E96AE" },
      "300": { "$value": "#C5CAD8" },
      "200": { "$value": "#DFE3EC" },
      "100": { "$value": "#EEF1F6" },
      "50": { "$value": "#F6F8FB" }
    },
    "tag": {
      "$type": "color",
      "$description": "«Бирка» — тёплое золото адресной бирки на ошейнике: акцент, пожертвования, прогресс, логотип. Текст на нём — только ink-900.",
      "700": { "$value": "#7A5300" },
      "600": { "$value": "#E2A312" },
      "500": { "$value": "#F5B82E" },
      "200": { "$value": "#FBE3A6" },
      "100": { "$value": "#FDF2D6" }
    },
    "sky": {
      "$type": "color",
      "$description": "«Небо» — путь «Забрать домой», информационные состояния, кольцо фокуса.",
      "700": { "$value": "#14606F" },
      "600": { "$value": "#1C7A8C" },
      "500": { "$value": "#2E93A8" },
      "200": { "$value": "#C4E5EC" },
      "100": { "$value": "#E3F2F5" }
    },
    "meadow": {
      "$type": "color",
      "$description": "«Луг» — путь «Погулять», слоты выгула.",
      "700": { "$value": "#2F5E2A" },
      "600": { "$value": "#3F7A38" },
      "500": { "$value": "#5E9C55" },
      "200": { "$value": "#D3E8CC" },
      "100": { "$value": "#EAF4E6" }
    },
    "success": {
      "$type": "color",
      "fg": { "$value": "#1B6E3F" },
      "solid": { "$value": "#23804A" },
      "bg": { "$value": "#E1F2E7" },
      "border": { "$value": "#9FD1B1" }
    },
    "warning": {
      "$type": "color",
      "fg": { "$value": "#8A4B00" },
      "solid": { "$value": "#F5B82E" },
      "bg": { "$value": "#FFF1D3" },
      "border": { "$value": "#F3CF7A" }
    },
    "danger": {
      "$type": "color",
      "fg": { "$value": "#B3261E" },
      "solid": { "$value": "#C0362C" },
      "bg": { "$value": "#FCE7E4" },
      "border": { "$value": "#F0B2AB" }
    },
    "info": {
      "$type": "color",
      "fg": { "$value": "#14606F" },
      "solid": { "$value": "#1C7A8C" },
      "bg": { "$value": "#E3F2F5" },
      "border": { "$value": "#A9D7E1" }
    },
    "neutral": {
      "$type": "color",
      "fg": { "$value": "#4F5B7D" },
      "bg": { "$value": "#EEF1F6" },
      "border": { "$value": "#C5CAD8" }
    },
    "white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "semantic": {
    "$description": "Роли цветов. В коде используются роли, а не палитра напрямую.",
    "surface": {
      "$type": "color",
      "page": { "$value": "{color.white}" },
      "canvas": { "$value": "{color.ink.50}", "$description": "фон секций и кабинетов" },
      "raised": { "$value": "{color.white}", "$description": "карточки, модальные окна" },
      "sunken": { "$value": "{color.ink.100}", "$description": "поля фильтров, неактивные области" },
      "inverse": { "$value": "{color.ink.900}", "$description": "подвал, тёмные блоки" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "{color.ink.900}" },
      "secondary": { "$value": "{color.ink.700}" },
      "muted": { "$value": "{color.ink.500}", "$description": "≥ 4.5:1 на white и ink-50" },
      "disabled": { "$value": "{color.ink.400}" },
      "inverse": { "$value": "{color.white}" },
      "link": { "$value": "{color.ink.900}", "$description": "ссылки всегда подчёркнуты" }
    },
    "border": {
      "$type": "color",
      "subtle": { "$value": "{color.ink.200}" },
      "default": { "$value": "{color.ink.300}" },
      "strong": { "$value": "{color.ink.500}", "$description": "граница полей ввода (≥ 3:1)" }
    },
    "focus": { "$type": "color", "$value": "{color.sky.600}", "$description": "кольцо фокуса 3px с отступом 2px" },
    "path": {
      "$type": "color",
      "$description": "Три пути помощи. Цвет — дополнение к иконке и подписи.",
      "adopt": { "$value": "{color.sky.100}", "$description": "Забрать домой / под опеку" },
      "donate": { "$value": "{color.tag.100}", "$description": "Пожертвовать" },
      "walk": { "$value": "{color.meadow.100}", "$description": "Погулять" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Unbounded", "Golos Text", "Arial", "sans-serif"], "$description": "заголовки H1–H4, крупные цифры; не мельче 18px" },
      "body": { "$value": ["Golos Text", "Arial", "sans-serif"], "$description": "текст, интерфейс, кнопки, таблицы" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Модульная шкала 1.25 от 16px (округлено до целых px).",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "md": { "$value": "18px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "25px" },
      "2xl": { "$value": "31px" },
      "3xl": { "$value": "39px" },
      "4xl": { "$value": "49px" },
      "5xl": { "$value": "61px" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.12 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.55 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "display": { "$value": "-0.02em" },
      "normal": { "$value": "0em" }
    }
  },
  "typography": {
    "$description": "Готовые текстовые стили. mobile — значение до брейкпоинта md.",
    "h1": { "family": "display", "weight": 600, "size": "4xl", "mobile": "2xl", "lineHeight": "tight", "letterSpacing": "display" },
    "h2": { "family": "display", "weight": 600, "size": "3xl", "mobile": "xl", "lineHeight": "tight", "letterSpacing": "display" },
    "h3": { "family": "display", "weight": 600, "size": "xl", "mobile": "lg", "lineHeight": "snug", "letterSpacing": "display" },
    "h4": { "family": "display", "weight": 500, "size": "lg", "mobile": "md", "lineHeight": "snug", "letterSpacing": "display" },
    "lead": { "family": "body", "weight": 400, "size": "md", "lineHeight": "normal" },
    "body": { "family": "body", "weight": 400, "size": "base", "lineHeight": "normal" },
    "small": { "family": "body", "weight": 400, "size": "sm", "lineHeight": "normal" },
    "caption": { "family": "body", "weight": 500, "size": "xs", "lineHeight": "snug" },
    "label": { "family": "body", "weight": 600, "size": "sm", "lineHeight": "snug" },
    "button": { "family": "body", "weight": 600, "size": "base", "lineHeight": "tight" },
    "number": { "family": "display", "weight": 600, "size": "2xl", "lineHeight": "tight", "$description": "суммы сборов, счётчики" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Сетка 4px.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Радиус растёт с размером элемента: мелкие — xs/sm, карточки — lg, бейджи и чипы — pill.",
    "xs": { "$value": "6px", "$description": "чекбокс, мелкие метки" },
    "sm": { "$value": "10px", "$description": "кнопки, поля ввода, слоты" },
    "md": { "$value": "16px", "$description": "фото внутри карточки, тосты" },
    "lg": { "$value": "24px", "$description": "карточки, модальные окна, секции" },
    "pill": { "$value": "999px", "$description": "бейджи, чипы фильтров" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Тени тонированы ink-900, а не чёрным. По умолчанию карточки без тени — с границей border.subtle.",
    "sm": { "$value": "0 1px 2px rgba(29, 43, 79, 0.08)" },
    "md": { "$value": "0 8px 24px -8px rgba(29, 43, 79, 0.22)", "$description": "наведение на карточку, выпадающие списки" },
    "lg": { "$value": "0 24px 56px -16px rgba(29, 43, 79, 0.35)", "$description": "модальные окна, тосты" }
  },
  "border": {
    "$type": "dimension",
    "width": { "$value": "1px" },
    "widthStrong": { "$value": "1.5px", "$description": "поля ввода, вторичная кнопка" }
  },
  "focus": {
    "ring": { "$type": "dimension", "$value": "3px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "36px" },
      "md": { "$value": "44px", "$description": "минимум для касания" },
      "lg": { "$value": "52px" }
    },
    "icon": {
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" }
    }
  },
  "layout": {
    "$type": "dimension",
    "container": { "$value": "1280px" },
    "containerNarrow": { "$value": "760px", "$description": "формы, тексты" },
    "columns": { "$type": "number", "$value": 12 },
    "gutter": {
      "mobile": { "$value": "16px" },
      "tablet": { "$value": "24px" },
      "desktop": { "$value": "32px" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Mobile first; макеты рисуются для 390 и 1440.",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.7, 0.2, 1] },
      "inOut": { "$value": [0.6, 0, 0.3, 1] }
    }
  }
}
