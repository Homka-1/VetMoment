# VetMoment — настройки сервера для docker-compose.prod.yml (см. docs/deploy.md).
# Скопируйте в deploy.env (он не попадает в git) и заполните.

# Домен сайта: DNS-запись A/AAAA должна указывать на этот сервер
APP_DOMAIN=vetmoment.example.kz

# Пароль PostgreSQL: длинный и случайный. Применяется только при первом создании тома базы
DB_PASSWORD=

# Почта для писем (сброс пароля, уведомления). Пример — SMTP с SSL на порту 465
MAIL_HOST=smtp.example.kz
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@vetmoment.example.kz

# true — загрузить демо-данные в пустую базу (для показа на сервере). По умолчанию false
SEED_DEMO=false

# Платежи: fake — демо-банк; cloudpayments_kz — нужен договор и ключи из кабинета провайдера
PAYMENT_GATEWAY=fake
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

LOG_LEVEL=warning
